APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
API_AUTH_ENABLED=false
API_KEY=
# Optional JSON map for RBAC and tenant isolation:
# API_CLIENTS={"viewer-key":{"role":"viewer","tenant_id":"tenant-a"}}

LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

DATABASE_URL=sqlite:///./threatlens.db
DATABASE_AUTO_CREATE=true

MAX_TOOL_CALLS=10
MAX_AGENT_RETRIES=2
MAX_TOOL_RETRIES=3
TOOL_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BACKEND=memory
REDIS_URL=

ENABLE_PDF_REPORTS=true
MOCK_ENRICHMENT=true

# Optional OpenTelemetry OTLP export
OTEL_ENABLED=false
OTEL_SERVICE_NAME=threatlens
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=

RETENTION_DAYS=90
BACKUP_DIR=backups
